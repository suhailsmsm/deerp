    "web:static": "expo export --platform web && python3 -m http.server 5500 -d dist",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@expo/vector-icons": "^14.0.0",
