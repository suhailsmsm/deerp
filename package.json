{
  "name": "pos-system",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.derp.erp",
    "productName": "dERP",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "prisma/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.35",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.2",
    "vite": "^8.0.13",
    "wait-on": "^7.2.0"
  }
}
